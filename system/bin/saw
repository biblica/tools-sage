#!/bin/sh
set -eu
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SETTINGS=""
JSON=0
NO_PROMPT=0
LOG_MODE=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --settings)
            [ "$#" -ge 2 ] || { printf '%s\n' 'saw: --settings requires a .yml filename' >&2; exit 2; }
            SETTINGS=$2
            shift 2
            ;;
        --json)
            JSON=1
            shift
            ;;
        --no-prompt)
            NO_PROMPT=1
            shift
            ;;
        --quiet|--verbose|--debug)
            LOG_MODE=$1
            shift
            ;;
        *) break ;;
    esac
done
run_sage() {
    if [ -n "$SETTINGS" ]; then
        set -- --settings "$SETTINGS" "$@"
    fi
    if [ "$JSON" -eq 1 ]; then
        set -- --json "$@"
    fi
    if [ "$NO_PROMPT" -eq 1 ]; then
        set -- --no-prompt "$@"
    fi
    if [ -n "$LOG_MODE" ]; then
        set -- "$LOG_MODE" "$@"
    fi
    exec "$BIN_DIR/sage" "$@"
}
COMMAND=${1:-status}
[ "$#" -eq 0 ] || shift
case "$COMMAND" in
    -h|--help|help)
        cat <<'HELP'
usage: saw [--settings FILE.yml] [--json] [--no-prompt] [--quiet|--verbose|--debug] <command> [options]

Authority model:
  WIP       = LWC work-in-progress translation under analysis
  REFERENCE = configured LWC Reference Project comparison
  GRK/HEB   = original-language authority when routed for a bounded OL question

Commands:
  status       Show SAW qualification and resource readiness
  qa           Create one bounded Standard QA ACT task
  focused      Create one bounded Targeted Check ACT task
  ol           Create one bounded original-language review ACT task
  submit       Validate and finalize one completed task
  plan         Build deterministic work units without analysis

Invalid commands, project IDs, and Scripture scopes are corrected interactively
when possible. Use --no-prompt or --json for structured INPUT_REQUIRED output.

Examples:
  ./system/bin/saw status
  ./system/bin/saw qa --wip ukrNPUv0 --reference usNIVv2 --scope "AMO 1:1-9:15" --grammar-override-id GRAMMAR_REVIEW_ID
  ./system/bin/saw focused --wip faTMNv0 --reference usNIVv2 --scope "JHN 1:1-5" --focus "Is the participant reference clear?" --type PARTICIPANT_REFERENCE --grammar-override-id GRAMMAR_REVIEW_ID
  ./system/bin/saw ol --wip faTMNv0 --reference usNIVv2 --scope "JHN 1:1-5" --focus "Does the WIP preserve the grammatical relationship?" --grammar-override-id GRAMMAR_REVIEW_ID
  ./system/bin/saw submit --task SAGEdata/jobs/saw/JOB_ID/runs/RUN_ID/tasks/TASK_ID/task-manifest.json

If QA returns a partition plan, execute every unit and aggregate with ./system/bin/sage task aggregate --plan PATH.
HELP
        ;;
    *) run_sage shortcut --workflow saw "$COMMAND" -- "$@" ;;
esac
