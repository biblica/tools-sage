{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sage-pcc/stage1/expression.schema.json",
  "title": "SAGE PCC Stage 1 — expression",
  "description": "Handover example; adapt to existing SAGE conventions while retaining semantics.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "expression_id": {
      "type": "string",
      "minLength": 1
    },
    "source_corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "source_surface": {
      "type": "string",
      "minLength": 1
    },
    "normalized_source_form": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "AUTHORIZED_REFERENCE",
        "SOURCE_DISCOVERY",
        "LOCAL_INPUT"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "TERM",
        "FIXED_PHRASE",
        "IDIOM",
        "FORMULA",
        "COLLOCATION",
        "OTHER"
      ]
    },
    "senses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sense_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "discriminator": {
            "type": "string",
            "minLength": 1
          },
          "review_state": {
            "type": "string",
            "enum": [
              "CURATED",
              "REVIEWED",
              "PROVISIONAL"
            ]
          }
        },
        "required": [
          "sense_id",
          "label",
          "discriminator",
          "review_state"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "expression_id",
    "source_corpus_id",
    "source_surface",
    "normalized_source_form",
    "origin",
    "category",
    "senses"
  ],
  "additionalProperties": false
}
