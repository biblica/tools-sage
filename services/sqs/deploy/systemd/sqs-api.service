[Unit]
Description=SAGE Qualification Service public API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqs
Group=sqs
WorkingDirectory=/opt/tools-sage-sqs
EnvironmentFile=/etc/sage-sqs/sqs-api.env
ExecStart=/opt/tools-sage-sqs/.venv/bin/uvicorn sage_sqs.runtime:create_app_from_env --factory --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sage-sqs

[Install]
WantedBy=multi-user.target
