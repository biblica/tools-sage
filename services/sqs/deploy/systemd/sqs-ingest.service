[Unit]
Description=SAGE Qualification Service qualification-submission ingest drain
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sqs
Group=sqs
WorkingDirectory=/opt/tools-sage-sqs
EnvironmentFile=/etc/sage-sqs/sqs-ingest.env
ExecStart=/opt/tools-sage-sqs/.venv/bin/sqs-ingest --drain
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sage-sqs
