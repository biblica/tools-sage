* text=auto

# SAGE-owned source and documentation use LF in the repository/worktree on POSIX.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.vrs text eol=lf
*.sh text eol=lf
/sage text eol=lf
/system/bin/sage text eol=lf
/system/bin/bic text eol=lf
/system/bin/saw text eol=lf

# Native Windows launchers remain CRLF.
*.cmd text eol=crlf

# Governed bundled Paratext resources retain their source-compatible CRLF form.
/system/resources/scripture/original-language/**/*.SFM text eol=crlf
/system/resources/scripture/original-language/**/BookNames.xml text eol=crlf
/system/resources/scripture/original-language/**/Settings.xml text eol=crlf

# Hash-pinned historical source text intentionally retains terminal whitespace semantics.
/system/skills/consolidate/SKILL.md whitespace=-blank-at-eof
/system/skills/consolidate/references/ORIGINAL-CONTRACT.md whitespace=-blank-at-eof
